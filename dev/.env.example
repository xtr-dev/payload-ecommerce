# SQLite database location (optional, defaults to dev/payload.db)
# DATABASE_URI=file:./custom-path/payload.db

# Run the demo on MongoDB instead of SQLite (DATABASE_URI is then required)
# DATABASE_ADAPTER=mongodb
# DATABASE_URI=mongodb://127.0.0.1/payload-ecommerce

# Run the demo on Postgres instead of SQLite (DATABASE_URI is then required)
# DATABASE_ADAPTER=postgres
# DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/payload_ecommerce

PAYLOAD_SECRET=YOUR_SECRET_HERE
