{
  "name": "@xtr-dev/payload-ecommerce",
  "version": "0.3.0",
  "description": "PayloadCMS plugin for e-commerce functionality - products, orders, carts, and checkout",
  "license": "MIT",
  "author": "XTR Development <dev@xtr.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtr-dev/payload-ecommerce.git"
  },
  "bugs": {
    "url": "https://github.com/xtr-dev/payload-ecommerce/issues"
  },
  "homepage": "https://github.com/xtr-dev/payload-ecommerce#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts TSX_TSCONFIG_PATH=./dev/tsconfig.json payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest",
    "test:mongo": "cross-env DATABASE_ADAPTER=mongodb vitest run",
    "test:pack": "pnpm build && sh scripts/verify-packed-exports.sh",
    "test:types": "pnpm build:types && tsc -p dev/type-tests/default-slugs && tsc -p dev/type-tests/renamed-slugs",
    "typecheck": "tsc --noEmit && pnpm test:types"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.94.2",
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/db-sqlite": "3.94.2",
    "@payloadcms/eslint-config": "3.9.0",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.15.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "4.1.12",
    "@xtr-dev/payload-billing": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.4.6",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.4.6",
    "open": "^10.1.0",
    "payload": "3.94.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "qs-esm": "7.0.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "rimraf": "3.0.2",
    "sharp": "0.34.2",
    "sort-package-json": "^2.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "payload": "^3.37.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
